# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# Reviewer console + reviewer API endpoints (POST /reviews, /train, ...). If empty, `python tasks.py run`
# writes one into .env and Docker generates one into its volume (python -m app.cli token prints it).
# Send it as "Authorization: Bearer <token>".
HAMI_REVIEWER_TOKEN=

# Public base URL of this API (the HTTPS URL on a server, docs/DEPLOY.md).
HAMI_PUBLIC_BASE_URL=http://localhost:8000

# Database: empty = SQLite file in HAMI_DATA_DIR. Hosted Postgres is a config change:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/hami
DATABASE_URL=
# docker compose --profile postgres: password of the bundled PostgreSQL (set a long random one on a server).
POSTGRES_PASSWORD=
# docker compose --profile https: public hostname Caddy gets a certificate for (docs/DEPLOY.md).
HAMI_DOMAIN=
# Docker: the API port is published on 127.0.0.1 only; 0.0.0.0 exposes it on the network (not needed with Caddy).
HAMI_BIND=127.0.0.1
# Artifact storage: empty = local folder (HAMI_DATA_DIR/artifacts); file:///path also works.
# An S3-compatible store is a new ArtifactStore implementation (docs/architecture.md).
STORAGE_URL=

# Storage (SQLite DB + content-addressed artifacts). Docker uses /data.
# HAMI_DATA_DIR=backend/storage
# HAMI_MODELS_DIR=backend/models

# Capture limits (safety rules).
CAPTURE_TIMEOUT_S=20
CAPTURE_MAX_REQUESTS=150
CAPTURE_MAX_BODY_BYTES=1500000
CAPTURE_CONCURRENCY=2
# Private-network targets are refused except these hosts (the synthetic test sites).
CAPTURE_ALLOW_HOSTS=localhost,*.localhost
SCAN_CACHE_TTL_S=21600

# Rate limits (per device ID; per IP = value x RATE_IP_MULTIPLIER).
RATE_SCANS_PER_MIN=12
RATE_LOOKUP_PER_MIN=60
RATE_DEFAULT_PER_MIN=120
RATE_SNAPSHOTS_PER_MIN=6
RATE_IP_MULTIPLIER=3

# Discovery worker (certificate transparency). Keep the gaps generous; never run mass scans
# from the campus network.
DISCOVERY_ENABLED=true
DISCOVERY_POLL_S=600
DISCOVERY_QUERY_GAP_S=20
DISCOVERY_CAPTURE_GAP_S=30
DISCOVERY_MAX_CAPTURES_PER_CYCLE=5
DISCOVERY_MAX_AGE_DAYS=7

# Approved bulk captures (legit_urls.csv etc.): seconds between page loads.
BULK_CAPTURE_GAP_S=5

# Synthetic test sites (automated tests only).
TESTSITE_PORT=8100
TESTSITE_BASE_URL=http://site-a.localhost:8100
RUN_TESTSITES=false
