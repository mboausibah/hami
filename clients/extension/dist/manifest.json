{
  "manifest_version": 3,
  "name": "Hami — حامي",
  "short_name": "Hami",
  "version": "1.0.0",
  "description": "Checks links before you pay: this page, any link, Google Search results and Google Maps listings. Arabic and English.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Hami — check this page",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options/options.html",
  "permissions": ["activeTab", "contextMenus", "storage", "alarms", "scripting", "webRequest"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://www.google.ae/search*"],
      "js": ["content-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/maps*", "http://listing.localhost/*"],
      "js": ["content-maps.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://www.google.com/search*", "https://www.google.ae/search*", "https://www.google.com/maps*"],
      "js": ["content-banner.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120"
}
